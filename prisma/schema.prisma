// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Chef {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String
  role Role @default(SOUS_CHEF)
  chefFoodItems ChefItems[]
  chefDrinkItems ChefDrinkItems[]
  @@map("chefs")
}

model ChefItems {
  chefId      Int
  foodItemId  Int

  chef      Chef      @relation(fields: [chefId], references: [id], onDelete: Cascade)
  foodItem  FoodItem  @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@id([chefId, foodItemId])
  @@map("chef_items")
}

model ChefDrinkItems {
  chefId      Int
  drinkItemId  Int

  chef      Chef      @relation(fields: [chefId], references: [id], onDelete: Cascade)
  drinkitem  DrinkItem  @relation(fields: [drinkItemId], references: [id], onDelete: Cascade)

  @@id([chefId, drinkItemId])
  @@map("chef_drink_items")

}

model DrinkItem {
  id    Int    @id @default(autoincrement())
  name  String @unique
  price Float

  chefDrinkItems ChefDrinkItems[]
  drinkComboItems ComboDrinkItems[]

  @@map("drink_items")
}

model FoodItem {
  id      Int         @id @default(autoincrement())
  name    String      @unique
  price   Float
  chefs   ChefItems[]
  combos  ComboItems[]

  @@map("food_items")
}


model ComboDrinkItems {
  comboId   Int
  drinkItemId Int

  drinkitem DrinkItem @relation(fields: [drinkItemId], references: [id], onDelete: Cascade)
  combo    Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@id([comboId, drinkItemId])
  @@map("combo_drink_items")
}

model ComboItems {
  comboId   Int
  foodItemId Int

  fooditem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  combo    Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@id([comboId, foodItemId])
  @@map("combo_items")
}

model Combo {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  price     Float
  foodItems ComboItems[]
  drinkItems ComboDrinkItems[]

  @@map("combos")
}


enum Role {
  HEAD_CHEF
  SOUS_CHEF
}